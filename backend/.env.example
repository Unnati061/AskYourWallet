# --- Database ----------------------------------------------------------------
# Zero-setup local development (the SQLite database file is created automatically).
DATABASE_URL=sqlite+aiosqlite:///./askyourwallet.db

# Hosted PostgreSQL option (Supabase / Neon free tier). Put the URL in your host's
# environment settings; change the prefix to postgresql+asyncpg://.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/askyourwallet

# --- JWT ---------------------------------------------------------------------
# Generate a strong value with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Groq (free tier) --------------------------------------------------------
# Get a key at https://console.groq.com -> API Keys -> Create API Key (starts "gsk_").
# Leave blank to run without AI: the dashboard, transactions, CSV import and
# budgets all work, and the chat page explains that the key is missing.
GROQ_API_KEY=

# Tool-calling model used by the chat assistant. llama-3.3-70b-versatile is no
# longer offered on Groq's free or developer tiers (retired 2026-08-16), so this
# defaults to Groq's documented free-tier replacement.
GROQ_MODEL=openai/gpt-oss-120b
# Smaller model for the single-label categorization fallback.
GROQ_CATEGORIZATION_MODEL=openai/gpt-oss-20b
# Safety valve on the chat tool-use loop.
GROQ_MAX_TOOL_ROUNDS=5

# --- CORS --------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
